#!name=Sub-Store
#!desc=https://sub.store
#!author=Peng-YM

[Script]
request if ${url} ~= /^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info)))/i then script("https://raw.githubusercontent.com/sub-store-org/Sub-Store/release/sub-store-1.min.js") with tag="Sub-Store", timeout=30, requires_body=true

request if ${url} ~= /^https?:\/\/sub\.store/i then script("https://raw.githubusercontent.com/sub-store-org/Sub-Store/release/sub-store-0.min.js") with tag="Sub-Store", timeout=30, requires_body=true

cron "0 0 * * *" then script("https://raw.githubusercontent.com/sub-store-org/Sub-Store/release/cron-sync-artifacts.min.js") with tag="Sub-Store", timeout=30

[MITM]
hostname = sub.store
